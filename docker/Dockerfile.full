# =============================================================================
# Full image: everything in the light image, plus the GPU-oriented and R-based
# synthetic data generators.
#
# Use this only if you need to regenerate synthetic data with TVAE, CTGAN, ARF,
# TabDDPM (all GPU-oriented; they run on CPU but slowly), or with the R methods
# Synthpop, RankSwap and CellSuppression. For everything else — including all
# 13 attacks and all paper tables — prefer the smaller docker/Dockerfile.
#
# Two conda environments are created because the SDG libraries (SDV, SynthCity,
# SmartNoise) require numpy/torch versions that conflict with the attack stack:
#   recon_  (Python 3.9)  — attacks, scoring, table regeneration
#   sdg     (Python 3.10) — synthetic data generation
#
# Build (from the repository root; this takes a while and produces a multi-GB
# image):
#     docker build -f docker/Dockerfile.full -t recon-artifact:full .
#
# Run:
#     docker run --rm -it -v "${PWD}":/workspace -w /workspace recon-artifact:full bash
#     conda run -n recon_ python master_experiment_script.py --n_runs 1
#     conda run -n sdg    python sdg/generate_synth.py sdg
# =============================================================================

FROM continuumio/miniconda3:25.1.1-2@sha256:0c1494093f919a36ba4cf543abf5e2e426deb3e8aa61c9d4074bcc267d264fe5

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    OMP_NUM_THREADS=1 \
    OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    NUMEXPR_NUM_THREADS=1 \
    WANDB_MODE=offline

# git for the pinned VCS dependencies. R is deliberately NOT installed from apt:
# Debian bookworm ships R 4.2.2 (2022), and both rpy2 3.6.4 (which binds the
# R_getVar symbol, added in R 4.5) and any recent CRAN snapshot need a newer R.
# R comes from conda-forge with the sdg environment below.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      git build-essential \
      libcurl4-openssl-dev libssl-dev libxml2-dev \
 && rm -rf /var/lib/apt/lists/*

# --- attack environment -------------------------------------------------------
COPY docker/requirements-attacks.txt /tmp/requirements-attacks.txt
RUN conda create -y -n recon_ python=3.9.23 \
 && conda run -n recon_ pip install --no-cache-dir -r /tmp/requirements-attacks.txt \
 && conda run -n recon_ pip install --no-cache-dir --no-deps \
      chex==0.1.90 optax==0.2.4 flax==0.8.5 \
 && conda clean -afy

# --- synthetic data generation environment -----------------------------------
# R and the two R packages come from conda-forge as prebuilt binaries for R 4.5.
# Building them from a CRAN snapshot against the distro's R 4.2.2 does not work:
# recent sources use R API functions (R_ClosureFormals, Rf_allocLang) that 4.2.2
# lacks, so Deriv fails to compile and takes synthpop down with it -- silently,
# because install.packages() only warns. Installing R into this environment also
# gives rpy2 the R it links against, with no R_HOME to set.
COPY docker/requirements-sdg.txt /tmp/requirements-sdg.txt
RUN conda create -y -n sdg -c conda-forge --override-channels \
      python=3.10.19 r-base=4.5.3 r-synthpop=1.9.2 r-sdcmicro=5.8.2 \
 && conda run -n sdg pip install --no-cache-dir -r /tmp/requirements-sdg.txt \
 && conda clean -afy

# smartnoise-synth 1.0.5 pins opacus<0.15.0 and synthcity 0.2.12 pins opacus>=1.3;
# installing both through the resolver is impossible. MST and AIM -- the only
# smartnoise synthesizers this artifact uses -- never import opacus, so it is
# installed without its declared dependencies, exactly as the light image does.
# Its real runtime dependencies (opendp, pac-synth, smartnoise-sql) are pinned in
# requirements-sdg.txt above.
RUN conda run -n sdg pip install --no-cache-dir --no-deps smartnoise-synth==1.0.5

# TabPFN ships without its weights and downloads a ~100 MB checkpoint into its
# own site-packages directory on first use. The image runs as a non-root user,
# who cannot write there, so the attack fails with a PermissionError the first
# time a reviewer runs it. Fetch the checkpoint at build time instead; this also
# means the image needs no network access at run time.
RUN conda run -n recon_ python -c "\
import numpy as np; \
from tabpfn import TabPFNClassifier; \
c = TabPFNClassifier(device='cpu', N_ensemble_configurations=1); \
c.fit(np.random.rand(20, 3), np.random.randint(0, 2, 20)); \
c.predict(np.random.rand(5, 3))" \
 && chmod -R a+rX /opt/conda/envs/recon_/lib/python3.9/site-packages/tabpfn

# Three fixes that only surface when the image is actually run:
#
# 1. conda-forge's R 4.5 brings ICU 78, which needs CXXABI_1.3.15. Bookworm's
#    system libstdc++ stops at 1.3.13, and /lib is a trusted loader directory
#    that ld.so.conf cannot override -- so once any pip package pulls in the
#    system library, conda's ICU fails to resolve. libstdc++ is forward
#    compatible, so pointing the system SONAME at the newer conda build fixes it
#    for every environment. Verified not to disturb recon_ (torch 1.13.1).
# 2. rpy2 locates R through R_HOME. `conda run -n sdg` sets it from the env's
#    activation scripts, but calling the interpreter directly does not, so set it
#    explicitly and both invocations work.
# 3. pycox (a synthcity dependency) mkdirs inside site-packages on import, which
#    fails for the non-root user the image runs as. Create it at build time.
# The libstdc++ filename carries its version, and conda picks that version, so
# it must be discovered rather than hard-coded: `ln -sf` to a name that does not
# exist silently creates a dangling link, which would break every C++ binary in
# the image with no build error. Resolve the newest match and fail the build
# loudly if there is none.
RUN set -eux; \
    libcxx="$(ls -1 /opt/conda/envs/sdg/lib/libstdc++.so.6.0.* | sort -V | tail -1)"; \
    test -f "$libcxx"; \
    ln -sfn "$libcxx" /lib/x86_64-linux-gnu/libstdc++.so.6; \
    test -f /lib/x86_64-linux-gnu/libstdc++.so.6; \
    mkdir -p /opt/conda/envs/sdg/lib/python3.10/site-packages/pycox/datasets/data; \
    chmod -R a+rwX /opt/conda/envs/sdg/lib/python3.10/site-packages/pycox/datasets

ENV R_HOME=/opt/conda/envs/sdg/lib/R

ARG UID=1000
ARG GID=1000
RUN groupadd --gid $GID recon 2>/dev/null || true \
 && useradd --uid $UID --gid $GID --create-home --shell /bin/bash recon 2>/dev/null || true
USER $UID:$GID

WORKDIR /workspace
CMD ["bash"]
