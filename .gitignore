__pycache__/
wandb/
out*.txt
.DS_Store
.idea/
*.csv
*.tex
*.te
outfiles/

# Generated figures
*.pdf

# SQLite results databases. results.db is shipped as part of the artifact
# (it backs experiment_scripts/regen_camera_tables.py), so it is un-ignored below.
*.db

# Manuscript (not part of the artifact)
manuscript/
manual_references.bib

# Miscellaneous generated/working files
mirador_report.txt
workspace/

# Internal research notes (not artifact material)
notes/
NIST_code/

