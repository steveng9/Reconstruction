CLAUDE.md
.claude/

# Dated/working backups of DBs, CSVs and tex (not artifact material)
*.bak
*.bak_*


# ---------------------------------------------------------------------------
# Artifact assets: these are deliberately tracked despite the broad rules above.
# ---------------------------------------------------------------------------
# The results database backing every paper table (see regen_camera_tables.py).
!experiment_scripts/results.db

# Result CSVs that regen_camera_tables.py reads alongside results.db. Tables 2,
# 7 and 9 cannot be regenerated without them, so they are part of the artifact.
!experiment_scripts/quality_results_merged.csv
!experiment_scripts/linear_sweep_adult_1000_20260822_182357.csv
!experiment_scripts/ds_risk_scores.csv
!experiment_scripts/per_attack_disparity_postrepair.csv

# The dummy dataset that lets reviewers exercise the pipeline with no downloads.
!data/dummy/
!data/dummy/**/*.csv
!data/dummy/**/*.json
!data/dummy/*.json

# Expected outputs committed for comparison during artifact evaluation.
!expected_output/
!expected_output/**/*.tex
!expected_output/**/*.csv
!expected_output/**/*.md
!expected_output/**/*.pdf
!expected_output/**/*.png

# Everything else under data/ is the author's local tree (symlinks to large
# datasets that are not redistributable) and must stay out of git.
/data/*
!/data/dummy/
!/data/README.md

# external/ holds the two dependency repos as pinned git submodules; they are
# tracked via .gitmodules, so nothing here is ignored.
